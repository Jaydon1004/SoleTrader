{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoleTrader",
  "version": "1.0.0",
  "identifier": "com.jaydo.soletrader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SoleTrader",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; font-src 'self' data:; img-src 'self' asset: http://asset.localhost blob: data:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1RDhFMzUzMDdEMkEzNkIKUldScm85SUhVK1BZZFpYMG5iMTV6SjdkNCsyZU95VkJPbmZzU0I5QW9Sbk9GR0M1SUhWWTg0NnUK",
      "endpoints": [
        "https://github.com/YOUR_USERNAME/SoleTrader/releases/latest/download/latest.json"
      ]
    }
  }
}
