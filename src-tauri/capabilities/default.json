{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$APPDATA/businesses/**/receipts/**" },
        { "path": "$APPDATA/businesses/**/documents/**" }
      ]
    },
    "sql:default",
    "notification:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file",
    "fs:allow-stat",
    "fs:allow-mkdir",
    "fs:allow-write-file",
    "fs:allow-write-text-file"
  ]
}
